# ==========================================
# EXPENSIO SPRING BOOT BACKEND CONFIGURATION
# ==========================================

# Server Port (matches frontend default 5001)
SERVER_PORT=5001

# Active Spring Profile (e.g. dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Database Connection
# Example Supabase pooled connection string:
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/expensio
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_or_local_password_here
FLYWAY_ENABLED=false

# JWT Authentication
# Must be a 256-bit+ secure random secret key
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Google OAuth (for mobile social sign-in verification)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# SMTP Email Provider Credentials (e.g. Resend, SendGrid, Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
