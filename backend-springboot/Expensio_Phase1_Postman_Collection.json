{
  "info": {
    "name": "Expensio - Phase 1 Auth System",
    "description": "Postman Collection for Phase 1 Authentication & Verification Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:5001/api/v1/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["api", "v1", "health"]
        }
      }
    },
    {
      "name": "2. Email Sign Up",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alan.doe@example.com\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Alan\",\n  \"lastName\": \"Doe\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/v1/auth/email/signup",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["v1", "auth", "email", "signup"]
        }
      }
    },
    {
      "name": "3. Verify Email OTP",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"challengeId\": \"REPLACE_WITH_CHALLENGE_ID_FROM_SIGNUP\",\n  \"otp\": \"REPLACE_WITH_OTP_FROM_LOGS\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/v1/verification/email/verify",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["v1", "verification", "email", "verify"]
        }
      }
    },
    {
      "name": "4. Mobile OTP Start",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919876543210\"\n}"
        },
        "url": {
          "raw": "http://localhost:5001/v1/auth/mobile/otp/start",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5001",
          "path": ["v1", "auth", "mobile", "otp", "start"]
        }
      }
    },
    {
      "name": "5. Verify Mobile OTP",
