# =================================================================
# Expensio Backend - Production Environment Variables
# Copy this file to .env on your Oracle Cloud VM and populate values
# =================================================================

PORT=8080

# Supabase PostgreSQL Database (Production Connection Pooler)
DB_URL=jdbc:postgresql://aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.cgsensrlcauiljsiyslk
DB_PASSWORD=your_supabase_password_here

# JWT Secret (Must be 256 bits / 32+ characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long!
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Google OAuth
GOOGLE_CLIENT_ID=895048152817-bd0o5nuuf888gbms8tvigavc9rqouk2g.apps.googleusercontent.com

# Twilio SMS (Optional in dev, required for live SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email (Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password
