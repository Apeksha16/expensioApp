{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-dist/cjs",
    "rootDir": "src"
  },
  "include": [
    "src/utils/**/*.ts",
    "src/components/**/*.tsx",
    "src/components/**/*.ts",
    "src/services/**/*.ts",
    "src/theme/**/*.ts",
    "src/core/**/*.ts",
    "src/config/**/*.ts",
    "src/data/**/*.ts",
    "src/types/**/*.ts",
    "src/context/**/*.tsx",
    "src/screens/**/*.tsx",
    "src/navigation/**/*.tsx"
  ]
}
