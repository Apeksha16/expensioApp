{
  "name": "expensio",
  "version": "1.0.0",
  "private": true,
  "description": "Expensio mobile app and backend workspace",
  "scripts": {
    "start": "npm --prefix frontend start",
    "server": "npm --prefix backend run dev",
    "backend": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend start",
    "frontend:web": "npm --prefix frontend run web",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "dev:web": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend:web\"",
    "web": "npm --prefix frontend run web",
    "android": "npm --prefix frontend run android",
    "ios": "npm --prefix frontend run ios"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
